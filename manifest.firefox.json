{
  "manifest_version": 3,
  "name": "Desk Batch Booker",
  "version": "__VERSION__",
  "description": "Book several days / tables on uob.smartway2book.com in one click.",
  "browser_specific_settings": {
    "gecko": {
      "id": "desk-batch-booker@invalid.example",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "host_permissions": ["https://uob.smartway2book.com/*"],
  "content_scripts": [
    {
      "matches": ["https://uob.smartway2book.com/*"],
      "js": ["places.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ]
}
